# Образец. Скопируй под именем .env и впиши свои значения. Файл .env никому не передавай и не коммить.
# Ключи бирж: только права MARKET DATA + TRADING. Права на вывод (WITHDRAWAL) НЕ давать.

# ---- Telegram ----------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
# Чат владельца (необязательно: иначе владелец - кто первым напишет /start боту)
TELEGRAM_CHAT_ID=

# ---- Биржи: слоты. EXCHANGE_n_NAME = kraken | coinbase | bitvavo | bitstamp | cryptocom | okx | bybit | gate | revolutx (binance/kucoin/mexc/bitget/htx - только источники сигнала)
# Bybit: по умолчанию работает в режиме Demo Trading (api-demo.bybit.com) - ключи создавай там.
# Ключ и секрет вписывай в две строки ниже сразу после знака "=", без пробелов и кавычек.
# (Вариант BYBIT_API_KEY= / BYBIT_API_SECRET= тоже работает.)
EXCHANGE_1_NAME=bybit
EXCHANGE_1_API_KEY=
EXCHANGE_1_API_SECRET=
EXCHANGE_2_NAME=okx
EXCHANGE_2_API_KEY=
EXCHANGE_2_API_SECRET=
EXCHANGE_2_PASSPHRASE=
EXCHANGE_3_NAME=kraken
EXCHANGE_3_API_KEY=
EXCHANGE_3_API_SECRET=
EXCHANGE_4_NAME=coinbase
EXCHANGE_4_API_KEY=
EXCHANGE_4_API_SECRET=
EXCHANGE_4_PASSPHRASE=
EXCHANGE_5_NAME=gate
EXCHANGE_5_API_KEY=
EXCHANGE_5_API_SECRET=
EXCHANGE_6_NAME=cryptocom
EXCHANGE_6_API_KEY=
EXCHANGE_6_API_SECRET=
EXCHANGE_7_NAME=revolutx
EXCHANGE_7_API_KEY=
# Revolut X: приватный ключ (private key) вписывай в API_SECRET
EXCHANGE_7_API_SECRET=
# Старый формат тоже понимается: BYBIT_API_KEY= / BYBIT_API_SECRET=

# ---- Необязательно: переопределения config.json (остальное меняется в UI/Telegram) ----
# MODE=PAPER                     PAPER (по умолчанию) | LIVE
# HUMAN_EXECUTION_TIME=7         секунд на ручное исполнение
# TELEGRAM_PROFIT_THRESHOLD=3    % NET для срочного алерта в Telegram
# CAPITAL=100                    размер сделки по умолчанию в карточке, $
# MAX_TRADE_SIZE=200
# MAX_RISK=2                     % капитала на сделку
# MAX_DAILY_LOSS=50              $ в день
# AUTO_CONFIRM=0                 1 - AUTO исполняет без подтверждения
# MIN_LIQUIDITY=50               $ глубины стакана с каждой стороны в пределах MAX_SLIPPAGE
# MAX_SLIPPAGE=0.3               %
# MAX_DATA_AGE=1500              мс, старше - стакан не используется
# MAX_API_LATENCY=1500           мс
# PAPER_BALANCE=10000            виртуальный баланс бумажной биржи
# WATCHLIST=BTC,ETH,SOL          или WATCHLIST=auto (самые ликвидные на Bybit)
# WATCHLIST_SIZE=15
# HOST=127.0.0.1
# PORT=8787
# PUBLIC_URL=http://127.0.0.1:8787   адрес для кнопки OPEN в Telegram
# LOG_LEVEL=INFO
# COINGECKO_API_KEY=
# ANTHROPIC_API_KEY=                анализ скриншотов сделок через Claude (необязательно; без ключа кнопка ANALYZE отключена)
